{
  "name": "systemone",
  "version": "1.0.0",
  "description": "Universal System One Decision Model Runner & MCP Server (Laya, Jev, and OpenAI-Compatible)",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "systemone": "dist/cli.js",
    "s1": "dist/cli.js",
    "systemone-mcp": "dist/mcp.js",
    "s1-mcp": "dist/mcp.js",
    "jev": "dist/cli.js",
    "jev-judge": "dist/cli.js",
    "jev-mcp": "dist/mcp.js"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "systemone.cmd",
    "s1.cmd",
    "systemone-mcp.cmd",
    "s1-mcp.cmd",
    "jev.cmd",
    "jev-mcp.cmd",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "mcp": "bun src/mcp.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "build": "bun build src/cli.ts src/mcp.ts src/index.ts --outdir dist --target node",
    "compile": "bun scripts/compile.ts",
    "compile:linux": "bun scripts/compile.ts --linux",
    "compile:all": "bun scripts/compile.ts --all"
  },
  "keywords": [
    "system-one",
    "systemone",
    "decision-model",
    "laya",
    "jev",
    "llm-judge",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "omp",
    "cursor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
