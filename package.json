{
  "name": "jev-judge",
  "version": "1.0.10",
  "description": "Universal TypeSafe Jev Decision Model Runner & MCP Server (OpenAI-Compatible & Direct)",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "jev": "dist/cli.js",
    "jev-judge": "dist/cli.js",
    "jev-mcp": "dist/mcp.js"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "jev.cmd",
    "jev-mcp.cmd",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "mcp": "bun src/mcp.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "build": "bun build src/cli.ts src/mcp.ts src/index.ts --outdir dist --target node",
    "compile": "bun scripts/compile.ts"
  },
  "keywords": [
    "jev",
    "decision-model",
    "system-one",
    "typesafe",
    "claude-code",
    "omp",
    "cursor",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  }
}
